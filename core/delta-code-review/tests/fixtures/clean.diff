-import { trimEnds } from '../src/string-utils';
+import { trimEnds, capitalize, isAsciiAlpha } from '../src/string-utils';

 describe('trimEnds', () => {
   it('trims spaces', () => {
     expect(trimEnds('  hi  ')).toBe('hi');
   });
 });
+
+describe('capitalize', () => {
+  it('capitalizes the first character', () => {
+    expect(capitalize('hello')).toBe('Hello');
+  });
+
+  it('handles empty string', () => {
+    expect(capitalize('')).toBe('');
+  });
+
+  it('leaves an already-capitalized string alone', () => {
+    expect(capitalize('Hello')).toBe('Hello');
+  });
+});
+
+describe('isAsciiAlpha', () => {
+  it('accepts pure-ASCII letters', () => {
+    expect(isAsciiAlpha('Hello')).toBe(true);
+  });
+
+  it('rejects empty string', () => {
+    expect(isAsciiAlpha('')).toBe(false);
+  });
+
+  it('rejects mixed digits', () => {
+    expect(isAsciiAlpha('hello123')).toBe(false);
+  });
+});
