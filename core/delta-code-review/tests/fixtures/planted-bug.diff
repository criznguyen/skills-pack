 export type User = { id: string; name: string; createdAt: string };

 export function sortById(users: User[]): User[] {
   return [...users].sort((a, b) => a.id.localeCompare(b.id));
 }

 export function findUser(users: User[], id: string): User | undefined {
   return users.find((u) => u.id === id);
 }
+
+/**
+ * Sort users alphabetically by name (ascending).
+ */
+export function sortByName(users: User[]): User[] {
+  // PLANTED BUG: subtracting strings yields NaN; sort order is undefined.
+  // The delta-code-review skill MUST flag this BLOCK / logic-bug.
+  return [...users].sort((a, b) => a.name - b.name);
+}
+
+/**
+ * Sort users newest-first by ISO `createdAt` timestamp.
+ * Lexical comparison of ISO 8601 strings is correct since the format is
+ * fixed-width and big-endian.
+ */
+export function sortByCreatedAtDesc(users: User[]): User[] {
+  return [...users].sort((a, b) => {
+    if (a.createdAt < b.createdAt) return 1;
+    if (a.createdAt > b.createdAt) return -1;
+    return 0;
+  });
+}
+
+/**
+ * Build an id -> user map. Last-write-wins on duplicate ids.
+ */
+export function indexById(users: User[]): Map<string, User> {
+  const out = new Map<string, User>();
+  for (let i = 0; i < users.length; i++) {
+    const u = users[i];
+    out.set(u.id, u);
+  }
+  return out;
+}
+
+/**
+ * Group users by the first character of their name (case-insensitive).
+ */
+export function groupByInitial(users: User[]): Map<string, User[]> {
+  const out = new Map<string, User[]>();
+  for (const u of users) {
+    const key = u.name.charAt(0).toUpperCase();
+    const bucket = out.get(key);
+    if (bucket) {
+      bucket.push(u);
+    } else {
+      out.set(key, [u]);
+    }
+  }
+  return out;
+}
+
+/**
+ * Returns the top-N users by name, alphabetical ascending.
+ */
+export function topNByName(users: User[], n: number): User[] {
+  return sortByName(users).slice(0, n);
+}
