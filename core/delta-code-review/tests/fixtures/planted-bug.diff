+import {
+  sortById,
+  findUser,
+  sortByCreatedAtDesc,
+  indexById,
+  groupByInitial,
+} from '../src/sort';

 describe('sortById', () => {
   it('sorts ascending by id', () => {
     expect(
       sortById([{ id: 'b', name: 'B', createdAt: '' }, { id: 'a', name: 'A', createdAt: '' }])
         .map((u) => u.id)
     ).toEqual(['a', 'b']);
   });
 });
+
+describe('sortByCreatedAtDesc', () => {
+  it('returns newest first', () => {
+    const users = [
+      { id: '1', name: 'A', createdAt: '2026-01-01T00:00:00Z' },
+      { id: '2', name: 'B', createdAt: '2026-04-01T00:00:00Z' },
+      { id: '3', name: 'C', createdAt: '2026-02-15T00:00:00Z' },
+    ];
+    expect(sortByCreatedAtDesc(users).map((u) => u.id)).toEqual(['2', '3', '1']);
+  });
+});
+
+describe('indexById', () => {
+  it('keys by id', () => {
+    const u = { id: 'x', name: 'X', createdAt: '' };
+    expect(indexById([u]).get('x')).toBe(u);
+  });
+});
+
+describe('groupByInitial', () => {
+  it('groups case-insensitively', () => {
+    const users = [
+      { id: '1', name: 'alice', createdAt: '' },
+      { id: '2', name: 'Bob', createdAt: '' },
+      { id: '3', name: 'Anna', createdAt: '' },
+    ];
+    const groups = groupByInitial(users);
+    expect(groups.get('A')?.length).toBe(2);
+    expect(groups.get('B')?.length).toBe(1);
+  });
+});
+
